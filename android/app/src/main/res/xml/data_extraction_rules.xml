<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: back up the notes and their pictures to the phone's Google account,
     and copy them when moving to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="notes.json" />
        <include domain="file" path="notes.previous.json" />
        <include domain="file" path="images" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="notes.json" />
        <include domain="file" path="notes.previous.json" />
        <include domain="file" path="images" />
    </device-transfer>
</data-extraction-rules>
